JWT_SECRET=lunaris-jwt-secret-cambiar-en-produccion-2025
JWT_EXPIRES_IN=24h
ADMIN_DEFAULT_PASSWORD=Admin123!
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Base de datos (sqlite | postgresql)
DB_TYPE=sqlite

# PostgreSQL (requerido si DB_TYPE=postgresql)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=lunaris
# PG_USER=postgres
# PG_PASSWORD=postgres

# Logging (error | warn | info | debug)
LOG_LEVEL=info

# Backups automáticos
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups

# Entorno (development | production | test)
NODE_ENV=development
